{
    "name": "raxos/contract",
    "description": "Interfaces used in Raxos.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library",
    "authors": [
        {
            "name": "Bas Milius",
            "email": "bas@mili.us"
        }
    ],
    "autoload": {
        "psr-4": {
            "Raxos\\Contract\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "symlink": true
        }
    ],
    "require": {
        "ext-pdo": "*",
        "php": ">=8.5"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "scripts": {
        "test": "pest --compact"
    }
}
